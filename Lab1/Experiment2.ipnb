 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Lab 1 - Experiment 2: Water Jug Problem\n",
    "**Objective:** Solve the Water Jug problem using state-space search (Breadth-First Search)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from collections import deque\n",
    "\n",
    "def water_jug_bfs(jug1_cap, jug2_cap, target):\n",
    "    \"\"\"Solves the Water Jug problem using Breadth-First Search (BFS).\"\"\"\n",
    "    \n",
    "    if target > max(jug1_cap, jug2_cap):\n",
    "        print(f\"Error: Target ({target}L) cannot exceed the maximum capacity of the jugs ({max(jug1_cap, jug2_cap)}L).\")\n",
    "        return False\n",
    "\n",
    "    visited = set()\n",
    "    queue = deque()\n",
    "    \n",
    "    # Initial state: (jug1, jug2)\n",
    "    initial_state = (0, 0)\n",
    "    queue.append((initial_state, []))\n",
    "    visited.add(initial_state)\n",
    "\n",
    "    while queue:\n",
    "        (j1, j2), path = queue.popleft()\n",
    "        \n",
    "        if j1 == target or j2 == target:\n",
    "            print(f\"\\n[Water Jug] Solution Found for target {target}L:\")\n",
    "            for step, state in enumerate(path + [(j1, j2)], 1):\n",
    "                print(f\"Step {step}: Jug 1 = {state[0]}L, Jug 2 = {state[1]}L\")\n",
    "            return True\n",
    "\n",
    "        # Generate all possible legal transitions\n",
    "        next_states = [\n",
    "            (jug1_cap, j2),                                             # Fill Jug 1\n",
    "            (j1, jug2_cap),                                             # Fill Jug 2\n",
    "            (0, j2),                                                    # Empty Jug 1\n",
    "            (j1, 0),                                                    # Empty Jug 2\n",
    "            (j1 - min(j1, jug2_cap - j2), j2 + min(j1, jug2_cap - j2)), # Pour Jug 1 -> Jug 2\n",
    "            (j1 + min(j2, jug1_cap - j1), j2 - min(j2, jug1_cap - j1))  # Pour Jug 2 -> Jug 1\n",
    "        ]\n",
    "\n",
    "        for state in next_states:\n",
    "            if state not in visited:\n",
    "                visited.add(state)\n",
    "                queue.append((state, path + [(j1, j2)]))\n",
    "                \n",
    "    print(\"[Water Jug] No solution possible for the given parameters.\")\n",
    "    return False"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Run the Water Jug Solver"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Example: Jug 1 = 4L, Jug 2 = 3L, Target = 2L\n",
    "j1_cap = 4\n",
    "j2_cap = 3\n",
    "target_val = 2\n",
    "\n",
    "water_jug_bfs(j1_cap, j2_cap, target_val)"
   ]
  }
 ],
 "metadata": {
  "language_info": {
   "name": "python"
  }
 },
