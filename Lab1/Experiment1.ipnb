 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Lab 1 - Experiment 1: Vacuum Cleaner Problem\n",
    "**Objective:** Implement a simple reflex agent that cleans rooms A and B based on percepts."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class VacuumCleanerAgent:\n",
    "    \"\"\"Simple reflex agent operating in a two-room environment.\"\"\"\n",
    "    \n",
    "    def __init__(self, location='A', state_A='Dirty', state_B='Dirty'):\n",
    "        self.location = location\n",
    "        self.environment = {'A': state_A, 'B': state_B}\n",
    "        self.cost = 0\n",
    "\n",
    "    def sense_and_act(self):\n",
    "        \"\"\"Executes the reflex agent rules until both rooms are clean.\"\"\"\n",
    "        print(f\"\\n[Vacuum Cleaner] Initial State -> Agent at Room {self.location}, Environment: {self.environment}\")\n",
    "        \n",
    "        while self.environment['A'] == 'Dirty' or self.environment['B'] == 'Dirty':\n",
    "            current_state = self.environment[self.location]\n",
    "            \n",
    "            if current_state == 'Dirty':\n",
    "                print(f\"Action: Suck -> Room {self.location} cleaned.\")\n",
    "                self.environment[self.location] = 'Clean'\n",
    "                self.cost += 1\n",
    "            elif self.location == 'A':\n",
    "                print(f\"Action: Move Right -> Moving from Room A to Room B.\")\n",
    "                self.location = 'B'\n",
    "                self.cost += 1\n",
    "            elif self.location == 'B':\n",
    "                print(f\"Action: Move Left -> Moving from Room B to Room A.\")\n",
    "                self.location = 'A'\n",
    "                self.cost += 1\n",
    "            \n",
    "            print(f\"Current State: Agent at Room {self.location}, Environment: {self.environment}\")\n",
    "        \n",
    "        print(f\"Goal Reached! Both rooms are clean. Total Actions Taken: {self.cost}\\n\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Run the Agent"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "agent = VacuumCleanerAgent(location='A', state_A='Dirty', state_B='Dirty')\n",
    "agent.sense_and_act()"
   ]
  }
 ],
