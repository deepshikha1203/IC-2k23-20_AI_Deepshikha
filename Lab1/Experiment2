"""
Lab 1 - Experiment 2: Water Jug Problem
Objective: Solve the Water Jug problem using state-space search (Breadth-First Search).
"""

from collections import deque

def water_jug_bfs(jug1_cap, jug2_cap, target):
    """Solves the Water Jug problem using Breadth-First Search (BFS)."""
    
    if target > max(jug1_cap, jug2_cap):
        print(f"Error: Target ({target}L) cannot exceed the maximum capacity of the jugs ({max(jug1_cap, jug2_cap)}L).")
        return False

    visited = set()
    queue = deque()
    
    # Initial state: (jug1, jug2)
    initial_state = (0, 0)
    queue.append((initial_state, []))
    visited.add(initial_state)

    while queue:
        (j1, j2), path = queue.popleft()
        
        if j1 == target or j2 == target:
            print(f"\n[Water Jug] Solution Found for target {target}L:")
            for step, state in enumerate(path + [(j1, j2)], 1):
                print(f"Step {step}: Jug 1 = {state[0]}L, Jug 2 = {state[1]}L")
            return True

        # Generate all possible legal transitions
        next_states = [
            (jug1_cap, j2),                                             # Fill Jug 1
            (j1, jug2_cap),                                             # Fill Jug 2
            (0, j2),                                                    # Empty Jug 1
            (j1, 0),                                                    # Empty Jug 2
            (j1 - min(j1, jug2_cap - j2), j2 + min(j1, jug2_cap - j2)), # Pour Jug 1 -> Jug 2
            (j1 + min(j2, jug1_cap - j1), j2 - min(j2, jug1_cap - j1))  # Pour Jug 2 -> Jug 1
        ]

        for state in next_states:
            if state not in visited:
                visited.add(state)
                queue.append((state, path + [(j1, j2)]))
                
    print("[Water Jug] No solution possible for the given parameters.")
    return False


if __name__ == "__main__":
    print("=" * 50)
    print("EXPERIMENT 2: WATER JUG PROBLEM")
    print("=" * 50)
    try:
        j1_cap = int(input("Enter capacity of Jug 1: "))
        j2_cap = int(input("Enter capacity of Jug 2: "))
        target_val = int(input("Enter target volume to measure: "))
        water_jug_bfs(j1_cap, j2_cap, target_val)
    except ValueError:
        print("Invalid input! Please enter integer values only.")
