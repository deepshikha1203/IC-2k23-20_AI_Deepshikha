"""
Lab 1 - Experiment 1: Vacuum Cleaner Problem
Objective: Implement a simple reflex agent that cleans rooms A and B based on percepts.
"""

class VacuumCleanerAgent:
    """Simple reflex agent operating in a two-room environment."""
    
    def __init__(self, location='A', state_A='Dirty', state_B='Dirty'):
        self.location = location
        self.environment = {'A': state_A, 'B': state_B}
        self.cost = 0

    def sense_and_act(self):
        """Executes the reflex agent rules until both rooms are clean."""
        print(f"\n[Vacuum Cleaner] Initial State -> Agent at Room {self.location}, Environment: {self.environment}")
        
        while self.environment['A'] == 'Dirty' or self.environment['B'] == 'Dirty':
            current_state = self.environment[self.location]
            
            if current_state == 'Dirty':
                print(f"Action: Suck -> Room {self.location} cleaned.")
                self.environment[self.location] = 'Clean'
                self.cost += 1
            elif self.location == 'A':
                print(f"Action: Move Right -> Moving from Room A to Room B.")
                self.location = 'B'
                self.cost += 1
            elif self.location == 'B':
                print(f"Action: Move Left -> Moving from Room B to Room A.")
                self.location = 'A'
                self.cost += 1
            
            print(f"Current State: Agent at Room {self.location}, Environment: {self.environment}")
        
        print(f"Goal Reached! Both rooms are clean. Total Actions Taken: {self.cost}\n")


if __name__ == "__main__":
    print("=" * 50)
    print("EXPERIMENT 1: VACUUM CLEANER PROBLEM")
    print("=" * 50)
    agent = VacuumCleanerAgent(location='A', state_A='Dirty', state_B='Dirty')
    agent.sense_and_act()
