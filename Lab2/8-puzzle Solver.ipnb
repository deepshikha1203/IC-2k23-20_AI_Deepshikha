{
    "cells": [
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "# Problem 4: 8-Puzzle Solver using A* Search\n",
                "\n",
                "### Objective\n",
                "Rearrange a $3 \\times 3$ sliding tile grid from an initial state to the target configuration in the minimum number of steps.\n",
                "\n",
                "### Cost Function\n",
                "$$f(n) = g(n) + h(n)$$\n",
                "- $g(n)$: Number of moves made so far (depth).\n",
                "- $h(n)$: Sum of Manhattan distances for all numbered tiles relative to their target slots."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "import heapq\n",
                "\n",
                "GOAL_STATE = (1, 2, 3, 4, 5, 6, 7, 8, 0)\n",
                "\n",
                "def calculate_manhattan(state):\n",
                "    dist = 0\n",
                "    for idx, tile in enumerate(state):\n",
                "        if tile != 0:\n",
                "            target_idx = tile - 1\n",
                "            curr_r, curr_c = divmod(idx, 3)\n",
                "            goal_r, goal_c = divmod(target_idx, 3)\n",
                "            dist += abs(curr_r - goal_r) + abs(curr_c - goal_c)\n",
                "    return dist\n",
                "\n",
                "def get_valid_neighbors(state):\n",
                "    neighbors = []\n",
                "    blank_idx = state.index(0)\n",
                "    r, c = divmod(blank_idx, 3)\n",
                "    \n",
                "    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n",
                "    for dr, dc in directions:\n",
                "        nr, nc = r + dr, c + dc\n",
                "        if 0 <= nr < 3 and 0 <= nc < 3:\n",
                "            swap_idx = nr * 3 + nc\n",
                "            new_state = list(state)\n",
                "            new_state[blank_idx], new_state[swap_idx] = new_state[swap_idx], new_state[blank_idx]\n",
                "            neighbors.append(tuple(new_state))\n",
                "            \n",
                "    return neighbors\n",
                "\n",
                "def solve_8_puzzle(initial_state):\n",
                "    initial_h = calculate_manhattan(initial_state)\n",
                "    pq = [(initial_h, 0, initial_state, [initial_state])]\n",
                "    visited = {initial_state: 0}\n",
                "    \n",
                "    while pq:\n",
                "        f_score, g_cost, current_state, path = heapq.heappop(pq)\n",
                "        \n",
                "        if current_state == GOAL_STATE:\n",
                "            return path\n",
                "            \n",
                "        for neighbor in get_valid_neighbors(current_state):\n",
                "            new_g = g_cost + 1\n",
                "            if neighbor not in visited or new_g < visited[neighbor]:\n",
                "                visited[neighbor] = new_g\n",
                "                new_f = new_g + calculate_manhattan(neighbor)\n",
                "                heapq.heappush(pq, (new_f, new_g, neighbor, path + [neighbor]))\n",
                "                \n",
                "    return None\n",
                "\n",
                "# Board configuration (0 denotes the blank tile)\n",
                "start_state = (1, 2, 3, 4, 5, 6, 0, 7, 8)\n",
                "solution = solve_8_puzzle(start_state)\n",
                "\n",
                "print(f\"Solved in {len(solution) - 1} moves:\\n\")\n",
                "for move_idx, board in enumerate(solution):\n",
                "    print(f\"Move {move_idx}:\")\n",
                "    print(board[0:3])\n",
                "    print(board[3:6])\n",
                "    print(board[6:9])\n",
                "    print()"
            ]
        }
    ],
    "metadata": {
        "language_info": {
            "name": "python"
        }
    },
