{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Lab 2 - Experiment 1: BFS and DFS Graph Search\n",
    "**Objective:** Implement unguided graph traversal algorithms to find paths between nodes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from collections import deque\n",
    "\n",
    "class GraphSearch:\n",
    "    def __init__(self, graph):\n",
    "        self.graph = graph\n",
    "\n",
    "    def bfs(self, start, goal):\n",
    "        queue = deque([[start]])\n",
    "        visited = set([start])\n",
    "\n",
    "        while queue:\n",
    "            path = queue.popleft()\n",
    "            node = path[-1]\n",
    "\n",
    "            if node == goal:\n",
    "                return path\n",
    "\n",
    "            for neighbor in self.graph.get(node, []):\n",
    "                if neighbor not in visited:\n",
    "                    visited.add(neighbor)\n",
    "                    new_path = list(path)\n",
    "                    new_path.append(neighbor)\n",
    "                    queue.append(new_path)\n",
    "        return None\n",
    "\n",
    "    def dfs(self, start, goal):\n",
    "        stack = [[start]]\n",
    "        visited = set()\n",
    "\n",
    "        while stack:\n",
    "            path = stack.pop()\n",
    "            node = path[-1]\n",
    "\n",
    "            if node == goal:\n",
    "                return path\n",
    "\n",
    "            if node not in visited:\n",
    "                visited.add(node)\n",
    "                for neighbor in reversed(self.graph.get(node, [])):\n",
    "                    if neighbor not in visited:\n",
    "                        new_path = list(path)\n",
    "                        new_path.append(neighbor)\n",
    "                        stack.append(new_path)\n",
    "        return None"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Execute Search on Sample Graph"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "sample_graph = {\n",
    "    'A': ['B', 'C'],\n",
    "    'B': ['D', 'E'],\n",
    "    'C': ['F'],\n",
    "    'D': [],\n",
    "    'E': ['F'],\n",
    "    'F': []\n",
    "}\n",
    "\n",
    "searcher = GraphSearch(sample_graph)\n",
    "print(\"BFS Path:\", searcher.bfs('A', 'F'))\n",
    "print(\"DFS Path:\", searcher.dfs('A', 'F'))"
   ]
  }
 ],
